<Window x:Class="DeskPokemon.MainWindow"
        xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:DeskPokemon"
        Title="DeskPokemon" SystemDecorations="None" TransparencyLevelHint="Transparent" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" CanResize="False" SizeToContent="WidthAndHeight"
        RenderOptions.BitmapInterpolationMode="None" RenderOptions.TextRenderingMode="Antialias">
  <Window.Resources>
    <ControlTheme x:Key="GenTab" TargetType="RadioButton">
      <Setter Property="Foreground" Value="#0C1D36"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Width" Value="116"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="Margin" Value="0,2,0,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="PART_HitBox" Background="Transparent">
            <Border Name="PART_Lift" IsHitTestVisible="False">
              <local:PixelSurface Name="PART_Frame" Asset="egg_timer_plate" Slice="4" Padding="2">
                <Border Name="PART_Focus" BorderThickness="1" BorderBrush="Transparent">
                  <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
              </local:PixelSurface>
            </Border>
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:checked /template/ local|PixelSurface#PART_Frame"><Setter Property="Asset" Value="exp_label_plate"/></Style>
      <Style Selector="^.evolvable /template/ Border#PART_Focus"><Setter Property="BorderBrush" Value="#2B9A62"/><Setter Property="BorderThickness" Value="2"/></Style>
      <Style Selector="^:focus-visible /template/ Border#PART_Focus"><Setter Property="BorderBrush" Value="#0C1D36"/></Style>
      <Style Selector="^:disabled"><Setter Property="Opacity" Value="0.45"/></Style>
    </ControlTheme>
    <ControlTheme x:Key="MenuTab" TargetType="ToggleButton">
      <Setter Property="Foreground" Value="#FFFBEF"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Width" Value="116"/>
      <Setter Property="Margin" Value="0,0,-2,0"/>
      <Setter Property="Height" Value="41"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="PART_HitBox" Background="Transparent">
            <Border Name="PART_Lift" IsHitTestVisible="False">
              <local:PixelSurface Name="PART_Frame" Asset="tab_settings" Slice="12,14,12,3" Padding="8,8,8,3">
                <Border Name="PART_Focus" BorderThickness="1" BorderBrush="Transparent">
                  <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
              </local:PixelSurface>
            </Border>
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:checked"><Setter Property="Foreground" Value="#0C1D36"/></Style>
      <Style Selector="^:checked /template/ local|PixelSurface#PART_Frame"><Setter Property="Asset" Value="tab_selected"/></Style>
      <Style Selector="^:focus-visible /template/ Border#PART_Focus"><Setter Property="BorderBrush" Value="#FFF2A6"/></Style>
    </ControlTheme>
    <ControlTheme x:Key="IconButton" TargetType="RadioButton">
      <Setter Property="ToolTip.ShowOnDisabled" Value="True"/>
      <Setter Property="Width" Value="52"/>
      <Setter Property="Height" Value="52"/>
      <Setter Property="Margin" Value="0,0,1,1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="PART_HitBox" Background="Transparent">
            <Border Name="PART_Lift" IsHitTestVisible="False">
              <local:PixelSurface Name="PART_Frame" Asset="slot_normal" Slice="4" Padding="4">
                <Border Name="PART_Focus" BorderThickness="1" BorderBrush="Transparent">
                  <Grid>
                    <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Name="PART_Shiny" Text="★" IsVisible="False" IsHitTestVisible="False"
                               FontFamily="{StaticResource SmallPixelFont}" FontSize="9" Foreground="#FFDB40" Background="#0C1D36"
                               Width="12" Height="12" TextAlignment="Center" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                  </Grid>
                </Border>
              </local:PixelSurface>
            </Border>
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^.missing /template/ local|PixelSurface#PART_Frame"><Setter Property="Asset" Value="slot_unknown"/></Style>
      <Style Selector="^:checked /template/ local|PixelSurface#PART_Frame"><Setter Property="Asset" Value="slot_selected"/></Style>
      <Style Selector="^.shiny /template/ TextBlock#PART_Shiny"><Setter Property="IsVisible" Value="True"/></Style>
      <Style Selector="^.evolvable /template/ Border#PART_Focus"><Setter Property="BorderBrush" Value="#2B9A62"/><Setter Property="BorderThickness" Value="2"/></Style>
      <Style Selector="^:focus-visible /template/ Border#PART_Focus"><Setter Property="BorderBrush" Value="#FFFBEF"/></Style>
      <Style Selector="^:disabled"><Setter Property="Opacity" Value="1"/></Style>
    </ControlTheme>
    <ControlTheme x:Key="SelectorButton" TargetType="Button">
      <Setter Property="Foreground" Value="#0C1D36"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="PART_HitBox" Background="Transparent">
            <Border Name="PART_Lift" IsHitTestVisible="False">
              <Border Name="PART_Focus" BorderBrush="Transparent" BorderThickness="1" Margin="2">
                <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </Border>
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:focus-visible /template/ Border#PART_Focus"><Setter Property="BorderBrush" Value="#0C1D36"/></Style>
      <Style Selector="^:disabled"><Setter Property="Opacity" Value="0.35"/></Style>
    </ControlTheme>
  </Window.Resources>
  <Window.ContextMenu>
    <ContextMenu RenderOptions.TextRenderingMode="Antialias">
      <MenuItem Header="전역 입력 다시 연결" Click="OnRetryInput"/>
      <MenuItem Header="스프라이트 다시 불러오기" Click="OnRetrySprite"/>
      <Separator/>
      <MenuItem Header="종료" Click="OnExit"/>
    </ContextMenu>
  </Window.ContextMenu>

  <LayoutTransformControl x:Name="UiZoom" ClipToBounds="False">
    <LayoutTransformControl.LayoutTransform><ScaleTransform ScaleX="1" ScaleY="1"/></LayoutTransformControl.LayoutTransform>
    <StackPanel x:Name="Root" Width="352" Background="Transparent" PointerPressed="OnDrag">
      <Button x:Name="EvolutionNotice" Click="OnEvolutionClick" IsVisible="False" HorizontalAlignment="Center"
              MaxWidth="336" Margin="8,2,8,4" AutomationProperties.Name="포켓몬 진화">
        <TextBlock x:Name="EvolutionNoticeText" Text="진화할 수 있어요!" TextWrapping="Wrap" TextAlignment="Center"/>
      </Button>
      <WrapPanel x:Name="EvolutionChoices" IsVisible="False" HorizontalAlignment="Center" MaxWidth="336" Margin="8,0,8,4"/>

      <!-- The pet and egg remain on the transparent desktop above the pixel panel. -->
      <Grid x:Name="TopArea" ColumnDefinitions="220,132" RowDefinitions="Auto,Auto" Margin="0,24,0,0">
        <Grid Grid.Column="0" VerticalAlignment="Bottom" UseLayoutRounding="False">
          <Image x:Name="PetShadow" Source="/Assets/PixelUI/pet_shadow.png" Width="96" Height="17" Stretch="Fill"
                 HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="-2,0,0,-8.5" IsHitTestVisible="False"/>
          <LayoutTransformControl x:Name="StageZoom" ClipToBounds="False" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="4,0">
            <LayoutTransformControl.LayoutTransform><ScaleTransform ScaleX="3" ScaleY="3"/></LayoutTransformControl.LayoutTransform>
            <!-- LayoutTransformControl owns its immediate child's RenderTransform. -->
            <Border>
            <Border x:Name="PetFacing" RenderTransformOrigin="50%,50%">
              <Border.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Border.RenderTransform>
              <Canvas x:Name="Stage" Width="42" Height="42" RenderTransformOrigin="50%,100%" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                <Canvas.RenderTransform><ScaleTransform/></Canvas.RenderTransform>
                <Image x:Name="Sprite" Stretch="Fill"/>
                <TextBlock x:Name="SpriteMissing" IsVisible="False" Width="60" FontSize="6" Foreground="#FFFBEF"
                           TextAlignment="Center" TextWrapping="Wrap"/>
              </Canvas>
            </Border>
            </Border>
          </LayoutTransformControl>
          <local:EvolutionEffect x:Name="EvolutionVisual" Width="220" IsVisible="False" IsHitTestVisible="False"
                                 HorizontalAlignment="Center" VerticalAlignment="Bottom" ClipToBounds="False"/>
        </Grid>
        <StackPanel Grid.Column="1" Grid.RowSpan="2" Width="104" VerticalAlignment="Bottom" Margin="0,0,20,7">
          <Grid x:Name="EggGroup">
            <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
            <StackPanel>
              <TextBlock x:Name="NewText" Text="NEW!" Foreground="#FFDB40" FontWeight="Bold" FontSize="11"
                         HorizontalAlignment="Center" IsVisible="False" Margin="0,0,0,2">
                <TextBlock.Effect><DropShadowEffect OffsetX="1" OffsetY="1" BlurRadius="0" Color="#0C1D36"/></TextBlock.Effect>
              </TextBlock>
              <Grid>
                <Image Source="/Assets/PixelUI/egg_shadow.png" Width="72" Height="18" Stretch="Fill" HorizontalAlignment="Center"
                       VerticalAlignment="Bottom" Margin="0,0,0,-4" IsHitTestVisible="False"/>
                <LayoutTransformControl x:Name="EggZoom" ClipToBounds="False" HorizontalAlignment="Center" IsVisible="{Binding IsVisible, ElementName=EggStage}">
                  <LayoutTransformControl.LayoutTransform><ScaleTransform ScaleX="2" ScaleY="2"/></LayoutTransformControl.LayoutTransform>
                  <Border>
                    <Canvas x:Name="EggStage" Width="28" Height="30" HorizontalAlignment="Center" RenderTransformOrigin="50%,100%"
                            Cursor="Hand" Background="Transparent" PointerPressed="OnEggClick" AutomationProperties.Name="알">
                      <Canvas.RenderTransform><TransformGroup><ScaleTransform/><RotateTransform/></TransformGroup></Canvas.RenderTransform>
                      <Ellipse x:Name="EggFallback" Width="24" Height="30" Canvas.Left="2" Fill="#F1E3C4" Stroke="#B8A47A" StrokeThickness="1"/>
                      <Image x:Name="EggImage" Width="28" Height="30" Stretch="Fill"/>
                      <Image x:Name="EggSparkles" Width="40" Height="38" Canvas.Left="-6" Canvas.Top="-6"
                             Stretch="Fill" IsVisible="False" IsHitTestVisible="False"/>
                      <Image x:Name="CrackImage" Stretch="Fill" IsVisible="False"/>
                      <Ellipse x:Name="Flash" Width="24" Height="30" Canvas.Left="2" Fill="White" Opacity="0" IsHitTestVisible="False"/>
                    </Canvas>
                  </Border>
                </LayoutTransformControl>
                <LayoutTransformControl x:Name="ResultZoom" ClipToBounds="False" HorizontalAlignment="Center" IsVisible="{Binding IsVisible, ElementName=ResultStage}">
                  <LayoutTransformControl.LayoutTransform><ScaleTransform ScaleX="2" ScaleY="2"/></LayoutTransformControl.LayoutTransform>
                  <Border>
                    <Canvas x:Name="ResultStage" Width="40" Height="30" HorizontalAlignment="Center" RenderTransformOrigin="50%,100%"
                            IsVisible="False" AutomationProperties.Name="부화결과">
                      <Canvas.RenderTransform><ScaleTransform/></Canvas.RenderTransform>
                      <Image x:Name="ResultImage" Stretch="Fill"/>
                    </Canvas>
                  </Border>
                </LayoutTransformControl>
              </Grid>
            </StackPanel>
            <Rectangle x:Name="EggEditFrame" Stroke="#FFD84A" StrokeThickness="1" StrokeDashArray="3,2" IsHitTestVisible="False" IsVisible="False"/>
          </Grid>
          <Grid x:Name="Bubble" HorizontalAlignment="Center" Margin="0,6,0,0">
            <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
            <local:PixelSurface Asset="egg_timer_plate" Slice="4" Padding="5,4" Width="98" MinHeight="28">
              <TextBlock x:Name="BubbleText" Text="30:00" Foreground="#0C1D36" FontSize="15" FontWeight="Bold"
                         TextAlignment="Center" TextWrapping="Wrap" MaxWidth="90"/>
            </local:PixelSurface>
            <Rectangle x:Name="BubbleEditFrame" Stroke="#FFD84A" StrokeThickness="1" StrokeDashArray="3,2" IsHitTestVisible="False" IsVisible="False"/>
          </Grid>
        </StackPanel>
      <StackPanel Grid.Row="1" Width="196" HorizontalAlignment="Left" Margin="20,4,0,7">
        <Grid ColumnDefinitions="*,Auto" Margin="5,0,26,0">
          <TextBlock x:Name="PetName" Text="포켓몬" FontSize="15" LineHeight="16" FontWeight="Bold" Foreground="#0C1D36" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Text, RelativeSource={RelativeSource Self}}">
            <TextBlock.Effect><DropShadowEffect OffsetX="1" OffsetY="1" BlurRadius="0" Color="#FFFBEF"/></TextBlock.Effect>
          </TextBlock>
          <TextBlock x:Name="LevelText" Grid.Column="1" Text="Lv. 1" Foreground="#0C1D36" FontWeight="Bold" FontSize="14" LineHeight="16"
                     RenderTransformOrigin="50%,50%">
            <TextBlock.RenderTransform><ScaleTransform/></TextBlock.RenderTransform>
            <TextBlock.Effect><DropShadowEffect OffsetX="1" OffsetY="1" BlurRadius="0" Color="#FFFBEF"/></TextBlock.Effect>
          </TextBlock>
        </Grid>
        <StackPanel x:Name="ExpGaugeRow" Orientation="Horizontal" HorizontalAlignment="Left" Margin="4,0,0,0">
          <local:PixelSurface Asset="exp_label_plate" Slice="4" Width="38" Height="22" Padding="3,2">
            <TextBlock Text="EXP" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </local:PixelSurface>
          <local:PixelSurface Asset="exp_track" Slice="3" Width="142" Height="19" Margin="-3,2,0,0" Padding="3,4">
            <Border x:Name="ExpTrack" Width="136" Height="11" Background="Transparent" ClipToBounds="True" ToolTip.Placement="Top" ToolTip.ShowDelay="300">
              <Rectangle x:Name="ExpBar" HorizontalAlignment="Left" Width="0" Height="11">
                <Rectangle.Fill><ImageBrush Source="/Assets/PixelUI/exp_fill_segment.png" DestinationRect="0,0,16,11" TileMode="Tile" Stretch="Fill"/></Rectangle.Fill>
              </Rectangle>
            </Border>
          </local:PixelSurface>
        </StackPanel>
      </StackPanel>
      </Grid>

      <Grid Height="42">
        <StackPanel x:Name="MenuTabs" Orientation="Horizontal" HorizontalAlignment="Left" Margin="4,0" VerticalAlignment="Bottom">
          <ToggleButton Tag="dex" Theme="{StaticResource MenuTab}" IsCheckedChanged="OnMenuChecked" AutomationProperties.Name="도감">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Image Source="/Assets/PixelUI/icon_dex.png" Width="22" Height="24" Stretch="Fill"/>
              <TextBlock Text="도감" VerticalAlignment="Center"/>
            </StackPanel>
          </ToggleButton>
          <ToggleButton Tag="box" Theme="{StaticResource MenuTab}" IsCheckedChanged="OnMenuChecked" AutomationProperties.Name="박스">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Image Source="/Assets/PixelUI/icon_box.png" Width="24" Height="24" Stretch="Fill"/>
              <TextBlock Text="박스" VerticalAlignment="Center"/>
            </StackPanel>
          </ToggleButton>
          <ToggleButton Tag="settings" Margin="0" Theme="{StaticResource MenuTab}" IsCheckedChanged="OnMenuChecked" AutomationProperties.Name="설정">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Image Source="/Assets/PixelUI/icon_settings.png" Width="24" Height="24" Stretch="Fill"/>
              <TextBlock Text="설정" VerticalAlignment="Center"/>
            </StackPanel>
          </ToggleButton>
        </StackPanel>
      </Grid>

      <Border x:Name="Drawer" Height="0" ClipToBounds="True" Margin="0,-2,0,0">
        <Border x:Name="DrawerContent" VerticalAlignment="Top">
          <local:PixelSurface Asset="drawer_frame" Slice="14,2,14,14" Padding="8,1,8,7">
            <ScrollViewer x:Name="DrawerScroll" MaxHeight="480" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
              <Grid>
                <StackPanel x:Name="DexPanel">
                  <local:PixelSurface Asset="toolbar_bg" Slice="0" Height="39" Padding="4,4,4,4">
                    <Grid ColumnDefinitions="117,8,65,6,40,6,*">
                      <local:PixelSurface Asset="generation_selector" Slice="4" Width="117" Height="31">
                        <Grid ColumnDefinitions="22,71,24">
                          <Button x:Name="PreviousGenerationButton" Theme="{StaticResource SelectorButton}" Click="OnPreviousGeneration" AutomationProperties.Name="이전 세대">
                            <Image Source="/Assets/PixelUI/arrow_left.png" Width="12" Height="17"/>
                          </Button>
                          <Button x:Name="GenerationPickerButton" Grid.Column="1" Theme="{StaticResource SelectorButton}" AutomationProperties.Name="세대 선택">
                            <TextBlock x:Name="GenerationText" Text="1세대" FontSize="15" FontWeight="Bold"/>
                            <Button.Flyout>
                              <Flyout Placement="Bottom">
                                <StackPanel x:Name="GenTabs"/>
                              </Flyout>
                            </Button.Flyout>
                          </Button>
                          <Button x:Name="NextGenerationButton" Grid.Column="2" Theme="{StaticResource SelectorButton}" Click="OnNextGeneration" AutomationProperties.Name="다음 세대">
                            <Image Source="/Assets/PixelUI/arrow_right.png" Width="12" Height="17"/>
                          </Button>
                        </Grid>
                      </local:PixelSurface>
                      <CheckBox x:Name="OwnedOnly" Grid.Column="2" Content="보유만" FontSize="13" FontWeight="Bold" IsCheckedChanged="OnOwnedOnlyChanged" VerticalAlignment="Center"/>
                      <CheckBox x:Name="ShinyDex" Grid.Column="4" Content="★" FontSize="12" IsCheckedChanged="OnShinyDexChanged" VerticalAlignment="Center"
                                ToolTip.Tip="이로치만" AutomationProperties.Name="이로치만"/>
                      <Viewbox x:Name="OwnedCountFit" Grid.Column="6" Stretch="Uniform" StretchDirection="DownOnly"
                               HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="OwnedCount" Text="보유 1/2072" FontSize="13" FontWeight="Bold"/>
                      </Viewbox>
                    </Grid>
                  </local:PixelSurface>
                  <Grid Margin="3,0" ColumnDefinitions="*,Auto">
                    <TextBlock x:Name="DexStatusText" IsVisible="False" FontSize="10" Foreground="#7B2B2B" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    <Button x:Name="RetryDexButton" Grid.Column="1" Content="다시 시도" IsVisible="False" Click="OnRetryDex" Padding="6,3" Margin="4,0,0,0"/>
                  </Grid>
                  <local:PixelSurface Asset="box_grid_bg" Slice="3" Padding="8,5,8,6" Margin="0,-1,0,0">
                    <ScrollViewer x:Name="IconScroll" Height="214" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
                      <WrapPanel x:Name="IconGrid" Width="318" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </ScrollViewer>
                  </local:PixelSurface>
                  <local:PixelSurface Asset="detail_base" Slice="0" Padding="5,4,6,7" Margin="0,-2,0,0">
                    <local:PixelSurface Asset="detail_panel" Slice="8" Padding="7,7,7,6" MinHeight="79">
                      <!-- Cover the artwork's fixed separator; the real separator follows the wrapping header. -->
                      <Border Background="#F3F0E1">
                      <Grid ColumnDefinitions="65,*" ColumnSpacing="7">
                        <local:PixelSurface Asset="portrait_frame" Slice="4" Width="65" Height="66" Padding="5" VerticalAlignment="Top">
                          <Image x:Name="DexDetailImage" Stretch="Uniform" Width="55" Height="56"/>
                        </local:PixelSurface>
                        <StackPanel Grid.Column="1" Spacing="4">
                          <Grid x:Name="DexDetailHeader" ColumnDefinitions="*,68" ColumnSpacing="4">
                            <WrapPanel VerticalAlignment="Center">
                              <TextBlock x:Name="DexDetailName" Text="포켓몬을 선택하세요" FontSize="15" FontWeight="Bold"
                                         MaxWidth="166" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,4,2"/>
                              <local:PixelSurface x:Name="DexTypeBadge" Asset="type_badge" Slice="4" Padding="6,2"
                                                  MinWidth="48" MaxWidth="166" MinHeight="18" VerticalAlignment="Center" Margin="0,0,0,2">
                                <TextBlock x:Name="DexDetailTypes" Text="???" Foreground="#FFFBEF"
                                           FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                              </local:PixelSurface>
                            </WrapPanel>
                            <local:PixelSurface x:Name="DexNumberBadge" Grid.Column="1" Asset="number_badge" Slice="4" Padding="4,2" Height="21" VerticalAlignment="Top">
                              <TextBlock x:Name="DexDetailNumber" Text="No. ????" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </local:PixelSurface>
                          </Grid>
                          <Border x:Name="DexDetailSeparator" Height="2" Background="#BDC7C2"/>
                          <TextBlock x:Name="DexDetailDescription" Text="도감에서 포켓몬을 골라 정보를 확인하세요." FontWeight="Bold"
                                     FontSize="13" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2" MinHeight="24"/>
                        </StackPanel>
                      </Grid>
                      </Border>
                    </local:PixelSurface>
                  </local:PixelSurface>
                </StackPanel>

                <StackPanel x:Name="SettingsPanel" IsVisible="False" Margin="12,12,12,10" Spacing="14">
                  <TextBlock Text="데스크톱 설정" FontSize="15" FontWeight="Bold"/>
                  <CheckBox x:Name="FlipCheckBox" Content="포켓몬 좌우 뒤집기" IsCheckedChanged="OnFlipChanged"/>
                  <StackPanel Spacing="5">
                    <CheckBox x:Name="StartupCheckBox" Content="로그인할 때 자동 실행" IsCheckedChanged="OnStartupChanged"/>
                    <TextBlock x:Name="StartupStatus" FontSize="10" Foreground="#526471" TextWrapping="Wrap" Margin="25,0,0,0"/>
                  </StackPanel>
                  <StackPanel Spacing="7">
                    <TextBlock Text="화면 크기" FontWeight="Bold" FontSize="11"/>
                    <Grid ColumnDefinitions="40,*,40" ColumnSpacing="8">
                      <Button x:Name="ScaleDownButton" Content="−" Click="OnScaleDown" AutomationProperties.Name="화면 축소" Padding="5"/>
                      <local:PixelSurface Grid.Column="1" Asset="number_badge" Slice="4" Padding="5">
                        <TextBlock x:Name="ScaleValue" Text="2×" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </local:PixelSurface>
                      <Button x:Name="ScaleUpButton" Grid.Column="2" Content="+" Click="OnScaleUp" AutomationProperties.Name="화면 확대" Padding="5"/>
                    </Grid>
                  </StackPanel>
                  <Button Content="DeskPokemon 종료" Click="OnExit" HorizontalAlignment="Stretch" Margin="0,5,0,0"/>
                </StackPanel>
              </Grid>
            </ScrollViewer>
          </local:PixelSurface>
        </Border>
      </Border>

      <Border x:Name="InputNotice" IsVisible="False" Margin="0,4,0,0">
        <local:PixelSurface Asset="detail_panel" Slice="8" Padding="10">
          <StackPanel Spacing="6">
            <TextBlock x:Name="InputStatusText" FontSize="11" TextWrapping="Wrap"/>
            <Button x:Name="InputRetryButton" Content="다시 확인 / 연결" Click="OnRetryInput" HorizontalAlignment="Center"/>
            <StackPanel x:Name="InputPermissionActions" IsVisible="False" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
              <Button x:Name="InputPermissionButton" Content="권한 요청" Click="OnRequestInputPermission"/>
              <Button Content="시스템 설정 열기" Click="OnOpenInputSettings"/>
            </StackPanel>
            <Expander x:Name="InputAppIdentity" IsVisible="False" Header="허용할 앱 확인" HorizontalAlignment="Stretch">
              <StackPanel Spacing="5">
                <TextBlock Text="현재 실행 중인 앱" FontSize="10"/>
                <SelectableTextBlock x:Name="InputAppPath" FontSize="10" TextWrapping="Wrap"/>
                <TextBlock FontSize="10" TextWrapping="Wrap" Text="DeskPokemon이 이미 켜져 있다면 위 경로의 앱인지 확인해 주세요. 새 빌드로 바꾼 뒤에는 기존 항목을 제거하고 현재 앱을 다시 추가한 후 앱을 재실행해야 할 수 있습니다."/>
              </StackPanel>
            </Expander>
          </StackPanel>
        </local:PixelSurface>
      </Border>
      <TextBlock x:Name="SpriteStatus" IsVisible="False" Foreground="#0C1D36" Background="#F3F0E1" FontSize="11" TextWrapping="Wrap" Padding="6" Margin="6,4"/>
    </StackPanel>
  </LayoutTransformControl>
</Window>
