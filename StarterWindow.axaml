<Window x:Class="DeskPokemon.StarterWindow"
        xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:DeskPokemon"
        Title="DeskPokemon - 스타팅 선택" SystemDecorations="None" TransparencyLevelHint="Transparent"
        Background="Transparent" Topmost="True" CanResize="False" SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen" RenderOptions.BitmapInterpolationMode="None"
        RenderOptions.TextRenderingMode="Antialias">
  <Window.Resources>
    <ControlTheme x:Key="Choice" TargetType="Button">
      <Setter Property="Margin" Value="4,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <ControlTemplate>
          <local:PixelSurface Name="PART_Frame" Asset="slot_normal" Slice="5" Padding="8,7">
            <Border Name="PART_Focus" BorderThickness="1" BorderBrush="Transparent">
              <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
            </Border>
          </local:PixelSurface>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover /template/ local|PixelSurface#PART_Frame"><Setter Property="Asset" Value="slot_selected"/></Style>
      <Style Selector="^:focus-visible /template/ Border#PART_Focus"><Setter Property="BorderBrush" Value="#FFFBEF"/></Style>
      <Style Selector="^:pressed /template/ local|PixelSurface#PART_Frame"><Setter Property="Asset" Value="slot_hover"/></Style>
    </ControlTheme>
  </Window.Resources>
  <local:PixelSurface Asset="drawer_frame" Slice="8" Padding="12,10" PointerPressed="OnDrag">
    <StackPanel>
      <Grid ColumnDefinitions="*,Auto" Margin="2,0,2,8">
        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
          <Image Source="/Assets/PixelUI/icon_dex.png" Width="16" Height="18" Stretch="Fill"/>
          <TextBlock Text="스타팅 포켓몬을 골라줘" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
        </StackPanel>
        <Button Grid.Column="1" Content="×" Click="OnClose" Padding="4,0" MinHeight="22" Width="22" AutomationProperties.Name="종료">
          <ToolTip.Tip><ToolTip Content="종료" RenderOptions.TextRenderingMode="Antialias"/></ToolTip.Tip>
        </Button>
      </Grid>
      <StackPanel x:Name="Choices" Orientation="Horizontal" HorizontalAlignment="Center"/>
    </StackPanel>
  </local:PixelSurface>
</Window>
