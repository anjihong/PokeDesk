<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DeskPokemon.App" RequestedThemeVariant="Light">
  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#E1AF15"/>
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://DeskPokemon/PixelStyles.axaml"/>
  </Application.Styles>
</Application>
