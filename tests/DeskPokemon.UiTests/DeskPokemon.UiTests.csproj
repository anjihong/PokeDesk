<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DeskPokemonAssembly Condition="'$(DeskPokemonAssembly)' == ''">../../bin/$(Configuration)/shiny-preview/DeskPokemon.dll</DeskPokemonAssembly>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="DeskPokemon">
      <HintPath>$(DeskPokemonAssembly)</HintPath>
    </Reference>
  </ItemGroup>
</Project>
