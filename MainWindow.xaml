<Window x:Class="DeskPokemon.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskPokemon"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        RenderOptions.BitmapScalingMode="NearestNeighbor">
  <Window.Resources>
    <!-- 스쿼시/스트레치 바운스. 발(하단 중앙) 기준. -->
    <Storyboard x:Key="Bounce">
      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Squash" Storyboard.TargetProperty="ScaleY">
        <LinearDoubleKeyFrame KeyTime="0:0:0.06" Value="0.8"/>
        <LinearDoubleKeyFrame KeyTime="0:0:0.14" Value="1.12"/>
        <LinearDoubleKeyFrame KeyTime="0:0:0.22" Value="1"/>
      </DoubleAnimationUsingKeyFrames>
      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Squash" Storyboard.TargetProperty="ScaleX">
        <LinearDoubleKeyFrame KeyTime="0:0:0.06" Value="1.15"/>
        <LinearDoubleKeyFrame KeyTime="0:0:0.14" Value="0.95"/>
        <LinearDoubleKeyFrame KeyTime="0:0:0.22" Value="1"/>
      </DoubleAnimationUsingKeyFrames>
    </Storyboard>

    <!-- 레벨업 시 레벨 텍스트 펄스 -->
    <Storyboard x:Key="LevelUp">
      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LevelPulse" Storyboard.TargetProperty="ScaleX">
        <LinearDoubleKeyFrame KeyTime="0:0:0.1" Value="1.5"/>
        <LinearDoubleKeyFrame KeyTime="0:0:0.35" Value="1"/>
      </DoubleAnimationUsingKeyFrames>
      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LevelPulse" Storyboard.TargetProperty="ScaleY">
        <LinearDoubleKeyFrame KeyTime="0:0:0.1" Value="1.5"/>
        <LinearDoubleKeyFrame KeyTime="0:0:0.35" Value="1"/>
      </DoubleAnimationUsingKeyFrames>
    </Storyboard>

    <!-- 알 준비 상태: 통통 튀는 루프 -->
    <Storyboard x:Key="EggIdle" RepeatBehavior="Forever">
      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="EggScale" Storyboard.TargetProperty="ScaleY">
        <LinearDoubleKeyFrame KeyTime="0:0:0" Value="1"/>
        <LinearDoubleKeyFrame KeyTime="0:0:0.15" Value="0.92"/>
        <LinearDoubleKeyFrame KeyTime="0:0:0.35" Value="1.06"/>
        <LinearDoubleKeyFrame KeyTime="0:0:0.5" Value="1"/>
        <LinearDoubleKeyFrame KeyTime="0:0:1.4" Value="1"/>
      </DoubleAnimationUsingKeyFrames>
    </Storyboard>

    <!-- 부화 중 흔들림 (코드에서 여러 번 재생) -->
    <Storyboard x:Key="EggShake">
      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="EggRotate" Storyboard.TargetProperty="Angle">
        <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
        <LinearDoubleKeyFrame KeyTime="0:0:0.08" Value="-12"/>
        <LinearDoubleKeyFrame KeyTime="0:0:0.2" Value="12"/>
        <LinearDoubleKeyFrame KeyTime="0:0:0.32" Value="-12"/>
        <LinearDoubleKeyFrame KeyTime="0:0:0.44" Value="12"/>
        <LinearDoubleKeyFrame KeyTime="0:0:0.52" Value="0"/>
      </DoubleAnimationUsingKeyFrames>
    </Storyboard>

    <!-- 부화 순간 흰 플래시 -->
    <Storyboard x:Key="FlashOut">
      <DoubleAnimation Storyboard.TargetName="Flash" Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.35"/>
    </Storyboard>

    <!-- 태어난 포켓몬 아이콘 팝 -->
    <Storyboard x:Key="ResultPop">
      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ResultScale" Storyboard.TargetProperty="ScaleX">
        <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
        <LinearDoubleKeyFrame KeyTime="0:0:0.2" Value="1.25"/>
        <LinearDoubleKeyFrame KeyTime="0:0:0.35" Value="1"/>
      </DoubleAnimationUsingKeyFrames>
      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ResultScale" Storyboard.TargetProperty="ScaleY">
        <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
        <LinearDoubleKeyFrame KeyTime="0:0:0.2" Value="1.25"/>
        <LinearDoubleKeyFrame KeyTime="0:0:0.35" Value="1"/>
      </DoubleAnimationUsingKeyFrames>
    </Storyboard>

    <!-- 세대 탭 -->
    <Style x:Key="GenTab" TargetType="RadioButton">
      <Setter Property="Foreground" Value="#DDDDDD"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Margin" Value="2,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bd" CornerRadius="4" Padding="7,2" Background="#33FFFFFF">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#55FFFFFF"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#FFD84A"/>
                <Setter Property="Foreground" Value="#202020"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 메뉴 탭(ToggleButton: 다시 누르면 접힘). 세대 탭과 같은 룩. -->
    <Style x:Key="MenuTab" TargetType="ToggleButton">
      <Setter Property="Foreground" Value="#DDDDDD"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Margin" Value="3,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Bd" CornerRadius="4" Padding="10,3" Background="#33FFFFFF">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#55FFFFFF"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#FFD84A"/>
                <Setter Property="Foreground" Value="#202020"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 아이콘 셀. 선택된 포켓몬은 노란 테두리. 미보유(비활성) 셀도 툴팁은 보이게. -->
    <Style x:Key="IconButton" TargetType="RadioButton">
      <Setter Property="Margin" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bd" CornerRadius="4" BorderThickness="2" BorderBrush="Transparent" Background="Transparent">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="#FFD84A"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Window.ContextMenu>
    <ContextMenu>
      <MenuItem Header="알 즉시 획득(테스트)" Click="OnDebugEgg"/>
      <Separator/>
      <MenuItem Header="종료" Click="OnExit"/>
    </ContextMenu>
  </Window.ContextMenu>

  <!-- Background=Transparent: 빈 영역도 히트테스트되어 드래그 가능. 버튼류·알은 클릭을 handled 처리하므로 드래그로 안 넘어감. -->
  <StackPanel Width="300" Background="Transparent" MouseLeftButtonDown="OnDrag">
    <!-- 상단: 포켓몬(왼쪽) + 알 열(오른쪽). 위쪽 여백은 스트레치(ScaleY 1.12) 시 잘리지 않도록. -->
    <Grid Margin="0,24,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <Canvas x:Name="Stage" Grid.Column="0" Width="42" Height="42" RenderTransformOrigin="0.5,1"
              HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="12,0">
        <Canvas.LayoutTransform>
          <ScaleTransform x:Name="Zoom" ScaleX="3" ScaleY="3"/>
        </Canvas.LayoutTransform>
        <Canvas.RenderTransform>
          <ScaleTransform x:Name="Squash"/>
        </Canvas.RenderTransform>
        <Image x:Name="Sprite" Stretch="Fill"/>
      </Canvas>

      <!-- 알 열: 말풍선 → NEW! → 알(또는 태어난 포켓몬) -->
      <StackPanel Grid.Column="1" Width="96" VerticalAlignment="Bottom" Margin="0,0,6,0">
        <Grid HorizontalAlignment="Center" Margin="0,0,0,2">
          <Border Background="#F0FFFFFF" CornerRadius="10" Padding="8,4" Margin="0,0,0,7">
            <TextBlock x:Name="BubbleText" Text="30:00" Foreground="#202020" FontSize="11" FontWeight="Bold"
                       TextAlignment="Center" TextWrapping="Wrap" MaxWidth="80"/>
          </Border>
          <!-- 말풍선 꼬리 -->
          <Polygon Points="0,0 10,0 3,7" Fill="#F0FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10,0,0,0"/>
        </Grid>

        <TextBlock x:Name="NewText" Text="NEW!" Foreground="#FFD84A" FontWeight="Bold" FontSize="14"
                   HorizontalAlignment="Center" Visibility="Collapsed" Margin="0,0,0,2">
          <TextBlock.Effect>
            <DropShadowEffect ShadowDepth="0" BlurRadius="4" Color="Black"/>
          </TextBlock.Effect>
        </TextBlock>

        <!-- 알: 28x30 원본을 2배. 발 기준 회전/스케일. -->
        <Canvas x:Name="EggStage" Width="28" Height="30" HorizontalAlignment="Center" RenderTransformOrigin="0.5,1"
                Cursor="Hand" Background="Transparent" MouseLeftButtonDown="OnEggClick"
                AutomationProperties.Name="알">
          <Canvas.LayoutTransform>
            <ScaleTransform ScaleX="2" ScaleY="2"/>
          </Canvas.LayoutTransform>
          <Canvas.RenderTransform>
            <TransformGroup>
              <ScaleTransform x:Name="EggScale"/>
              <RotateTransform x:Name="EggRotate"/>
            </TransformGroup>
          </Canvas.RenderTransform>
          <!-- 에셋 로드 전/실패 시 대체 -->
          <Ellipse x:Name="EggFallback" Width="24" Height="30" Canvas.Left="2" Fill="#F1E3C4" Stroke="#B8A47A" StrokeThickness="1"/>
          <Image x:Name="EggImage" Width="28" Height="30" Stretch="Fill"/>
          <Image x:Name="CrackImage" Stretch="Fill" Visibility="Collapsed"/>
          <Rectangle x:Name="Flash" Width="28" Height="30" Fill="White" Opacity="0" IsHitTestVisible="False"/>
        </Canvas>

        <!-- 태어난 포켓몬 아이콘(40x30 원본을 2배) -->
        <Image x:Name="ResultImage" Width="40" Height="30" Stretch="None" HorizontalAlignment="Center"
               RenderTransformOrigin="0.5,1" Visibility="Collapsed" AutomationProperties.Name="부화결과">
          <Image.LayoutTransform>
            <ScaleTransform ScaleX="2" ScaleY="2"/>
          </Image.LayoutTransform>
          <Image.RenderTransform>
            <ScaleTransform x:Name="ResultScale"/>
          </Image.RenderTransform>
        </Image>
      </StackPanel>
    </Grid>

    <!-- 레벨 + 경험치 바 -->
    <StackPanel HorizontalAlignment="Center" Margin="0,4,0,6">
      <TextBlock x:Name="LevelText" Text="Lv. 1" Foreground="White" FontWeight="Bold" FontSize="14"
                 HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
        <TextBlock.RenderTransform>
          <ScaleTransform x:Name="LevelPulse"/>
        </TextBlock.RenderTransform>
        <TextBlock.Effect>
          <DropShadowEffect ShadowDepth="0" BlurRadius="4" Color="Black"/>
        </TextBlock.Effect>
      </TextBlock>
      <Border x:Name="ExpTrack" Width="100" Height="6" CornerRadius="3" Background="#A0000000" Margin="0,2,0,0">
        <Rectangle x:Name="ExpBar" HorizontalAlignment="Left" Width="0" Fill="#FFD84A" RadiusX="3" RadiusY="3"/>
      </Border>
    </StackPanel>

    <!-- 메뉴 탭. 누르면 아래 서랍이 펼쳐지고 다시 누르면 접힘. 2·3은 추후. -->
    <Border Background="#CC202020" CornerRadius="8" Padding="6,5">
      <StackPanel x:Name="MenuTabs" Orientation="Horizontal" HorizontalAlignment="Left">
        <ToggleButton Content="도감" Tag="dex" Style="{StaticResource MenuTab}" Checked="OnMenuChecked" Unchecked="OnMenuUnchecked"/>
        <ToggleButton Content="메뉴 2" Tag="menu2" Style="{StaticResource MenuTab}" Checked="OnMenuChecked" Unchecked="OnMenuUnchecked" IsEnabled="False"/>
        <ToggleButton Content="메뉴 3" Tag="menu3" Style="{StaticResource MenuTab}" Checked="OnMenuChecked" Unchecked="OnMenuUnchecked" IsEnabled="False"/>
      </StackPanel>
    </Border>

    <!-- 서랍: Height를 0↔내용 높이로 애니메이션 -->
    <Border x:Name="Drawer" Height="0" ClipToBounds="True">
      <Border x:Name="DrawerContent" Background="#CC202020" CornerRadius="8" Padding="6" Margin="0,4,0,0" VerticalAlignment="Top">
        <Grid>
          <!-- 도감: 세대 탭 + 보유만 보기 + 아이콘 격자 (코드에서 채움). 미보유 종은 실루엣·선택 불가. -->
          <StackPanel x:Name="DexPanel">
            <StackPanel x:Name="GenTabs" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4"/>
            <Grid Margin="2,0,2,4">
              <CheckBox x:Name="OwnedOnly" Content="보유만 보기" Foreground="#DDDDDD" FontSize="11" VerticalAlignment="Center"
                        HorizontalAlignment="Left" Checked="OnOwnedOnlyChanged" Unchecked="OnOwnedOnlyChanged"/>
              <TextBlock x:Name="OwnedCount" Text="보유 1/1025" Foreground="#DDDDDD" FontSize="11"
                         HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
            <ScrollViewer x:Name="IconScroll" Height="150"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <WrapPanel x:Name="IconGrid"/>
            </ScrollViewer>
          </StackPanel>
          <TextBlock x:Name="PlaceholderPanel" Text="준비 중" Foreground="#DDDDDD" HorizontalAlignment="Center"
                     Margin="0,40" Visibility="Collapsed"/>
        </Grid>
      </Border>
    </Border>
  </StackPanel>
</Window>
