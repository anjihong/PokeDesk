<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:DeskPokemon">
  <Styles.Resources>
    <FontFamily x:Key="PixelFont">avares://DeskPokemon/Assets/Fonts#Galmuri11</FontFamily>
    <FontFamily x:Key="SmallPixelFont">avares://DeskPokemon/Assets/Fonts#Galmuri9</FontFamily>
    <ControlTheme x:Key="PixelButton" TargetType="Button">
      <Setter Property="Foreground" Value="#0C1D36"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="MinHeight" Value="28"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="PART_HitBox" Background="Transparent">
            <Border Name="PART_Lift" IsHitTestVisible="False">
              <local:PixelSurface Name="PART_Frame" Asset="egg_timer_plate" Slice="4" Padding="{TemplateBinding Padding}">
                <Border Name="PART_Focus" BorderThickness="1" BorderBrush="Transparent">
                  <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                </Border>
              </local:PixelSurface>
            </Border>
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pressed /template/ local|PixelSurface#PART_Frame"><Setter Property="Opacity" Value="0.8"/></Style>
      <Style Selector="^:focus-visible /template/ Border#PART_Focus"><Setter Property="BorderBrush" Value="#0C1D36"/></Style>
      <Style Selector="^:disabled"><Setter Property="Opacity" Value="0.45"/></Style>
    </ControlTheme>
    <ControlTheme x:Key="PixelCheckBox" TargetType="CheckBox">
      <Setter Property="Foreground" Value="#0C1D36"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="MinHeight" Value="24"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="Transparent" Padding="0,1">
            <Grid ColumnDefinitions="19,*">
              <Grid Width="19" Height="19" VerticalAlignment="Center">
                <Border Name="PART_Lift" IsHitTestVisible="False">
                  <Grid>
                    <local:PixelSurface Name="PART_Check" Asset="checkbox_off" Slice="3"/>
                    <Border Name="PART_Focus" BorderThickness="1" BorderBrush="Transparent" Margin="2"/>
                  </Grid>
                </Border>
              </Grid>
              <ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                Margin="5,0,0,0" VerticalAlignment="Center"/>
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:checked /template/ local|PixelSurface#PART_Check"><Setter Property="Asset" Value="checkbox_on"/></Style>
      <Style Selector="^:focus-visible /template/ Border#PART_Focus"><Setter Property="BorderBrush" Value="#8E671D"/></Style>
      <Style Selector="^:disabled"><Setter Property="Opacity" Value="0.45"/></Style>
    </ControlTheme>
  </Styles.Resources>
  <Style Selector="Window">
    <Setter Property="FontFamily" Value="{StaticResource PixelFont}"/>
    <Setter Property="Foreground" Value="#0C1D36"/>
    <Setter Property="UseLayoutRounding" Value="True"/>
  </Style>
  <Style Selector="Button"><Setter Property="Theme" Value="{StaticResource PixelButton}"/></Style>
  <Style Selector="CheckBox"><Setter Property="Theme" Value="{StaticResource PixelCheckBox}"/></Style>
  <!-- Each pixel template draws its own keyboard focus. Avoid a second overlay intercepting hover. -->
  <Style Selector=":is(Button)"><Setter Property="FocusAdorner" Value="{x:Null}"/></Style>
  <!-- Only the artwork moves. The transparent template root keeps a stationary hit target. -->
  <Style Selector=":is(Button) /template/ Border#PART_Lift">
    <Setter Property="RenderTransform" Value="translate(0px, 0px)"/>
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" Easing="CubicEaseOut"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector=":is(Button):not(:disabled):pointerover /template/ Border#PART_Lift">
    <Setter Property="RenderTransform" Value="translate(0px, -2px)"/>
  </Style>
  <Style Selector=":is(Button):pressed /template/ Border#PART_Lift">
    <Setter Property="RenderTransform" Value="translate(0px, 0px)"/>
  </Style>
  <Style Selector="ToolTip">
    <Setter Property="FontFamily" Value="{StaticResource PixelFont}"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Foreground" Value="#0C1D36"/>
    <Setter Property="Background" Value="#F3F0E1"/>
    <Setter Property="BorderBrush" Value="#0C1D36"/>
    <Setter Property="BorderThickness" Value="2"/>
    <Setter Property="CornerRadius" Value="0"/>
  </Style>
  <Style Selector="ContextMenu">
    <Setter Property="FontFamily" Value="{StaticResource PixelFont}"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Background" Value="#F3F0E1"/>
    <Setter Property="Foreground" Value="#0C1D36"/>
    <Setter Property="BorderBrush" Value="#0C1D36"/>
    <Setter Property="BorderThickness" Value="2"/>
  </Style>
  <Style Selector="MenuItem"><Setter Property="Foreground" Value="#0C1D36"/></Style>
  <Style Selector="FlyoutPresenter">
    <Setter Property="FontFamily" Value="{StaticResource PixelFont}"/>
    <Setter Property="Foreground" Value="#0C1D36"/>
    <Setter Property="Background" Value="#F3F0E1"/>
    <Setter Property="BorderBrush" Value="#0C1D36"/>
    <Setter Property="BorderThickness" Value="2"/>
    <Setter Property="CornerRadius" Value="0"/>
    <Setter Property="Padding" Value="6"/>
  </Style>
</Styles>
